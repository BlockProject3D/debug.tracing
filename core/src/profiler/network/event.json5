{
    name: "event",
    imports: [
        { protocol: "common", type: "Location" },
        { protocol: "common", type: "Field" },
        { protocol: "common", type: "SpanId" }
    ],
    enums: [
        {
            name: "Level",
            variants: {
                "None": 0, // This is not really a level, more like a marker to use the default from the debug server.
                "Trace": 1,
                "Debug": 2,
                "Info": 3,
                "Warn": 4,
                "Error": 5
            }
        }
    ],
    structs: [
        {
            name: "Header",
            fields: [
                {
                    name: "id",
                    info: {
                        type: "struct",
                        item_type: "SpanId"
                    }
                },
                {
                    name: "timestamp",
                    info: {
                        type: "signed",
                        bits: 64
                    }
                },
                {
                    name: "level",
                    info: {
                        type: "unsigned",
                        bits: 8
                    },
                    view: {
                        type: "enum",
                        name: "Level"
                    }
                }
            ]
        }
    ],
    messages: [
        {
            name: "Log",
            fields: [
                {
                    name: "header",
                    info: {
                        type: "item",
                        item_type: "Header"
                    }
                },
                {
                    name: "location",
                    info: {
                        type: "item",
                        item_type: "Location"
                    }
                },
                {
                    name: "fields",
                    info: {
                        type: "list",
                        item_type: "Field",
                        max_len: 255,
                        max_size: 512
                    }
                }
            ]
        }
    ]
}