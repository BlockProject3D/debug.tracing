{
    name: "event",
    imports: [
        { protocol: "common", type: "Location" },
        { protocol: "common", type: "Field" },
        { protocol: "common", type: "SpanId" }
    ],
    enums: [
        {
            name: "Level",
            variants: {
                "None": 0, // This is not really a level, more like a marker to use the default from the debug server.
                "Disabled": 1,
                "Trace": 2,
                "Debug": 3,
                "Info": 4,
                "Warn": 5,
                "Error": 6
            }
        }
    ],
    structs: [
        {
            name: "Header",
            fields: [
                {
                    name: "id",
                    description: "Span id this log event is attached to, 0 if not attached to any span.",
                    info: {
                        type: "struct",
                        item_type: "SpanId"
                    }
                },
                {
                    name: "timestamp",
                    description: "Unix timestamp in microseconds of this event.",
                    info: {
                        type: "signed",
                        bits: 64
                    }
                },
                {
                    name: "level",
                    description: "Event level.",
                    info: {
                        type: "unsigned",
                        bits: 8
                    },
                    view: {
                        type: "enum",
                        name: "Level"
                    }
                }
            ]
        }
    ],
    messages: [
        {
            name: "Log",
            fields: [
                {
                    name: "header",
                    info: {
                        type: "item",
                        item_type: "Header"
                    }
                },
                {
                    name: "location",
                    info: {
                        type: "item",
                        item_type: "Location"
                    }
                },
                {
                    name: "fields",
                    info: {
                        type: "list",
                        item_type: "Field",
                        max_len: 255,
                        max_size: 512
                    }
                }
            ]
        }
    ]
}