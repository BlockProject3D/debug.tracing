{
    name: "span",
    imports: [
        { protocol: "common", type: "Location" },
        { protocol: "common", type: "Field" },
        { protocol: "common", type: "SpanId" }
    ],
    structs: [
        {
            name: "Exit",
            fields: [
                { name: "id", item_type: "SpanId" },
                {
                    name: "end",
                    info: {
                        type: "unsigned",
                        bits: 64
                    }
                }
            ]
        }
    ],
    messages: [
        {
            name: "Callsite",
            fields: [
                {
                    name: "id",
                    info: {
                        type: "unsigned",
                        bits: 32
                    }
                },
                {
                    name: "name",
                    info: {
                        type: "string"
                    }
                },
                { name: "location", item_type: "Location" }
            ]
        },
        {
            name: "Enter",
            fields: [
                { name: "id", item_type: "SpanId" },
                {
                    name: "start",
                    info: {
                        type: "unsigned",
                        bits: 64
                    }
                },
                {
                    name: "fields",
                    info: {
                        type: "list",
                        item_type: "Field",
                        max_len: 255
                    }
                }
            ]
        },
        {
            name: "Record",
            fields: [
                { name: "id", item_type: "SpanId" },
                {
                    name: "fields",
                    info: {
                        type: "list",
                        item_type: "Field",
                        max_len: 255
                    }
                }
            ]
        }
    ]
}